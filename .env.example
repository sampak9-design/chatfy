# PostgreSQL connection (Railway provides this automatically)
DATABASE_URL="postgresql://user:password@host:5432/chatfy"

# Redis (Railway provides this automatically)
REDIS_URL="redis://default:password@host:6379"

# Public app URL (Railway gives you a *.up.railway.app domain) — used to register the Telegram webhook
APP_URL="https://your-app.up.railway.app"

# Webhook secret — random string used to validate webhook requests come from Telegram
TELEGRAM_WEBHOOK_SECRET="change-me-to-a-long-random-string"

# Admin auth — JWT signing secret (generate with `openssl rand -base64 32`)
AUTH_SECRET="change-me-to-a-long-random-string"

# Default admin (created on first boot if no admin exists)
ADMIN_EMAIL="admin@chatfy.local"
ADMIN_PASSWORD="changeme123"

# Node env
NODE_ENV="production"
