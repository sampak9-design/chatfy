// Chatfy — Telegram bot management platform
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

model Bot {
  id              String   @id @default(cuid())
  name            String
  token           String   @unique
  username        String?
  welcomeFlowId   String?
  active          Boolean  @default(true)
  webhookSecret   String
  // Meta Conversions API (Facebook Ads)
  metaPixelId     String?
  metaAccessToken String?
  metaTestCode    String?  // optional: filter as "test_event" in Events Manager
  // Postback secret (corretora calls /api/track/registered?secret=...)
  postbackSecret  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  leads             Lead[]
  flows             Flow[]
  broadcasts        Broadcast[]
  welcomeFlow       Flow?              @relation("WelcomeFlow", fields: [welcomeFlowId], references: [id])
  landings          Landing[]
  trackingSessions  TrackingSession[]
  conversionEvents  ConversionEvent[]
  funnels           Funnel[]

  @@map("bots")
}

model Funnel {
  id        String   @id @default(cuid())
  botId     String
  name      String
  graph     Json     // { nodes: [...], edges: [...] } — ReactFlow JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@map("funnels")
}

enum LeadStatus {
  active
  blocked
  unsubscribed
}

enum LeadOrigin {
  start
  button
  campaign
}

model Lead {
  id             String     @id @default(cuid())
  botId          String
  telegramId     String
  firstName      String?
  lastName       String?
  username       String?
  phone          String?
  status         LeadStatus @default(active)
  origin         LeadOrigin @default(start)
  source         String?    // free-form tracking from /start <param>, e.g. "fb_ad_campaign_1"
  languageCode   String?
  currentFlowId  String?
  currentStepId  String?
  lastInteraction DateTime  @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  bot           Bot     @relation(fields: [botId], references: [id], onDelete: Cascade)
  currentFlow   Flow?   @relation("LeadCurrentFlow", fields: [currentFlowId], references: [id])
  broadcastLogs BroadcastLog[]
  messages      Message[]
  trackingSessions TrackingSession[]

  @@unique([botId, telegramId])
  @@index([botId, status])
  @@index([botId, createdAt])
  @@index([botId, lastInteraction])
  @@map("leads")
}

enum MessageDirection {
  in
  out
}

enum MessageKind {
  text
  image
  video
  audio
  document
  sticker
  other
}

model Landing {
  id          String   @id @default(cuid())
  botId       String
  slug        String   // /l/<slug>
  name        String
  title       String   @default("Acesse nosso bot")
  subtitle    String?
  ctaText     String   @default("Acessar agora")
  flowId      String?  // optional: triggers this flow on /start (else welcome flow)
  brokerUrl   String?  // we append ?ref=<sessionId> to attribute registration
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bot      Bot               @relation(fields: [botId], references: [id], onDelete: Cascade)
  flow     Flow?             @relation("LandingFlow", fields: [flowId], references: [id])
  sessions TrackingSession[]

  @@unique([botId, slug])
  @@index([botId])
  @@map("landings")
}

model TrackingSession {
  id            String    @id @default(cuid())
  botId         String
  landingId     String?
  // Click metadata (from URL + cookies)
  fbclid        String?
  fbp           String?
  fbc           String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  utmTerm       String?
  ip            String?
  userAgent     String?
  // Conversion timeline
  pageViewAt    DateTime  @default(now())
  leadAt        DateTime?
  registeredAt  DateTime?
  depositedAt   DateTime?
  depositValue  Float?
  // Linked entities
  leadId        String?
  brokerUserId  String?
  brokerEmail   String?

  bot     Bot               @relation(fields: [botId], references: [id], onDelete: Cascade)
  landing Landing?          @relation(fields: [landingId], references: [id], onDelete: SetNull)
  lead    Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  events  ConversionEvent[]

  @@index([botId, pageViewAt])
  @@index([landingId])
  @@index([leadId])
  @@map("tracking_sessions")
}

enum ConversionEventType {
  PageView
  Lead
  CompleteRegistration
  Purchase
  Custom
}

model ConversionEvent {
  id         String              @id @default(cuid())
  sessionId  String
  botId      String
  type       ConversionEventType
  value      Float?
  currency   String?
  ok         Boolean             @default(true)
  response   Json?
  createdAt  DateTime            @default(now())

  session TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  bot     Bot             @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([botId, createdAt])
  @@map("conversion_events")
}

model Message {
  id         String           @id @default(cuid())
  botId      String
  leadId     String
  direction  MessageDirection
  kind       MessageKind      @default(text)
  text       String?
  mediaUrl   String?          // for outgoing: the URL we sent. For incoming: not stored (Telegram file_id stored instead).
  fileId     String?          // Telegram file_id for incoming media (so we can re-fetch later if needed)
  buttons    Json?            // [[{ text, url|callback_data }, ...], ...] — Telegram inline keyboard layout we sent
  fromAdmin  Boolean          @default(false) // outgoing: true if sent manually from inbox, false if from flow/broadcast
  createdAt  DateTime         @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([botId, createdAt])
  @@map("messages")
}

model Flow {
  id          String   @id @default(cuid())
  botId       String
  name        String
  description String?
  active      Boolean  @default(true)
  graph       Json     // ReactFlow graph: { nodes: [...], edges: [...] } — source of truth for the editor
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bot          Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  steps        FlowStep[]
  welcomeForBots Bot[]      @relation("WelcomeFlow")
  leadsHere    Lead[]       @relation("LeadCurrentFlow")
  landings     Landing[]    @relation("LandingFlow")

  @@index([botId])
  @@map("flows")
}

enum StepType {
  text
  image
  video
  audio
  document
  delay
  buttons
}

model FlowStep {
  id           String   @id @default(cuid())
  flowId       String
  nodeId       String   // matches the React Flow node id inside Flow.graph
  type         StepType
  content      String?  // text body / caption
  mediaUrl     String?
  buttons      Json?    // [{ id, label, kind: "url"|"callback"|"support", value, nextStepId? }]
  delaySeconds Int?
  isEntry      Boolean  @default(false)
  nextStepId   String?  // implicit next step (when no buttons), references another FlowStep.id
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, nodeId])
  @@index([flowId])
  @@map("flow_steps")
}

enum BroadcastStatus {
  draft
  scheduled
  queued
  sending
  done
  failed
}

model Broadcast {
  id           String          @id @default(cuid())
  botId        String
  name         String
  text         String?
  mediaUrl     String?
  mediaType    StepType?       // image | video | audio | document
  buttons      Json?
  status       BroadcastStatus @default(draft)
  scheduledFor DateTime?       // when set, jobs are enqueued with delay; status starts as "scheduled"
  targetFilter Json?           // { status?: "active", origin?: "start", ... }
  totalTargets Int             @default(0)
  sentCount    Int             @default(0)
  failedCount  Int             @default(0)
  blockedCount Int             @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  bot  Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  logs BroadcastLog[]

  @@index([botId, createdAt])
  @@map("broadcasts")
}

enum DeliveryStatus {
  pending
  sent
  failed
  blocked
}

model BroadcastLog {
  id           String         @id @default(cuid())
  broadcastId  String
  leadId       String
  status       DeliveryStatus @default(pending)
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime       @default(now())

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, leadId])
  @@index([broadcastId, status])
  @@map("broadcast_logs")
}
